# Copy to .env.local (git-ignored) and fill in values from Firebase console:
# Project settings → General → Your apps → Web app → SDK setup and configuration.
#
# All VITE_* values are PUBLIC: they are shipped inside the browser bundle.
# They identify the Firebase project; they are NOT secrets and do NOT grant access.
# Access is enforced by firestore.rules and Firebase Authentication.
#
# NEVER put a service-account key, Admin SDK credential, or private key in a VITE_ variable.

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Set to "true" only while running the local Firebase emulators (npm run emulators).
VITE_USE_EMULATORS=false
